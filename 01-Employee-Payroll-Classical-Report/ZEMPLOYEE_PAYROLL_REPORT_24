CLEAR lwa_data.

lwa_data-emp_id = 103.
lwa_data-name = 'john'.
lwa_data-dept = 'admin'.
lwa_data-base = '25000'.
APPEND lwa_data TO lt_data.
CLEAR lwa_data.

LOOP AT lt_data INTO lwa_data.
  lwa_data-hra = lwa_data-base * 20 / 100.
  lwa_data-da = lwa_data-base * 15 / 100.
  lwa_data-pf = lwa_data-base * 12 / 100.
  lwa_data-gross = lwa_data-base + lwa_data-hra + lwa_data-da.
  lwa_data-net = lwa_data-gross - lwa_data-pf.

  MODIFY lt_data FROM lwa_data.

ENDLOOP.
MODIFY  zemployee_24 FROM TABLE lt_data.

SORT lt_data BY net DESCENDING.

LOOP AT lt_data INTO lwa_data.
  IF  lwa_data-net > 50000.
    WRITE : / lwa_data-emp_id , lwa_data-name,lwa_data-dept ,lwa_data-base, lwa_data-hra,  lwa_data-da,  lwa_data-pf,  lwa_data-gross,lwa_data-net.
  ELSE.
    WRITE : / 'not found'.
  ENDIF.
ENDLOOP.
READ TABLE lt_data INTO lwa_data WITH KEY emp_id = 1004.
IF sy-subrc = 0.
  WRITE : / lwa_data-emp_id , lwa_data-name,lwa_data-dept ,lwa_data-base, lwa_data-hra,  lwa_data-da,  lwa_data-pf,  lwa_data-gross,lwa_data-net.

ENDIF.

LOOP AT lt_data INTO lwa_data.
  COLLECT lwa_data INTO ltemp_data.
ENDLOOP.

LOOP AT lt_data INTO lwa_data.
  WRITE : / lwa_data-emp_id , lwa_data-name,lwa_data-dept ,lwa_data-base, lwa_data-hra,  lwa_data-da,  lwa_data-pf,  lwa_data-gross,lwa_data-net.

ENDLOOP.
