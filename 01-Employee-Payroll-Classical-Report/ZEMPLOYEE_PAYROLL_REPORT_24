REPORT zemployee_payroll_report_24.

TYPES : BEGIN OF lty_data,
          emp_id(10) TYPE c,
          name(10)   TYPE c,
          dept(5)    TYPE c,
          base       TYPE p LENGTH 8 DECIMALS 2,
          hra        TYPE p LENGTH 8  DECIMALS 2,
          da         TYPE p LENGTH 8  DECIMALS 2,
          pf         TYPE p LENGTH 8  DECIMALS 2,
          gross      TYPE p LENGTH 8  DECIMALS 2,
          net        TYPE p LENGTH 8  DECIMALS 2,
        END OF lty_data.

DATA : lt_data TYPE TABLE OF zemployee_24.
DATA : ltemp_data TYPE TABLE OF zemployee_24.
DATA : lwa_data TYPE zemployee_24.
FIELD-SYMBOLS : <lfs_data> TYPE zemployee_24.

lwa_data-emp_id = 104.
lwa_data-name = 'priya'.
lwa_data-dept = 'it'.
lwa_data-base = '60000'.
APPEND lwa_data TO lt_data.
CLEAR lwa_data.

lwa_data-emp_id = 102.
lwa_data-name = 'anu'.
lwa_data-dept = 'HR'.
lwa_data-base = '50000'.
APPEND lwa_data TO lt_data.
CLEAR lwa_data.

lwa_data-emp_id = 105.
lwa_data-name = 'ravi'.
lwa_data-dept = 'sales'.
lwa_data-base = '45000'.
APPEND lwa_data TO lt_data.
CLEAR lwa_data.

lwa_data-emp_id = 101.
lwa_data-name = 'ram'.
lwa_data-dept = 'it'.
lwa_data-base = '35000'.
